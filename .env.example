# Copie para .env.local (desenvolvimento) ou cadastre no painel da hospedagem (produção).
# Nunca use o prefixo NEXT_PUBLIC_ nestas variáveis: elas são segredos do servidor.

# Banco central (PostgreSQL). Em produção é obrigatório; sem ele o site de estudos
# continua funcionando, mas sem o coletor e sem o banco central.
# Em desenvolvimento, se ficar vazio, é usado um banco embutido em .data/pglite.
DATABASE_URL=

# Área administrativa (/admin). Senha com 12+ caracteres e segredo com 32+ caracteres.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Segredo do agendamento diário (16+ caracteres). A Vercel o envia automaticamente
# no cabeçalho Authorization ao chamar /api/cron/crawl.
CRON_SECRET=

# Horário da coleta diária (opcional). Se mudar, ajuste também o cron em UTC no vercel.json.
CRAWLER_TIMEZONE=America/Sao_Paulo
CRAWLER_DAILY_HOUR=3

# Página pública com informações do robô (opcional; aparece no User-Agent do coletor).
CRAWLER_CONTACT_URL=

# Endereço público do site (opcional), aceito como origem válida nas ações do painel.
APP_ORIGIN=
